# Copy to .env and edit. .env is gitignored; this template is committed.
#
#   cp .env.example .env

# --- Serial link to the host ESP32 ------------------------------------------
# Differs per machine. Find yours:
#   macOS / Linux:  ls /dev/tty.* | grep -i -E 'usb|wch|slab'
#   Windows:        Device Manager > Ports (COM & LPT)
SERIAL_PORT=/dev/tty.usbserial-0001

# 115200 is NOT enough for full CIR reports — see README.
# Set this to match the Serial.begin() in the host firmware.
BAUD_RATE=921600


# --- Mesh layout ------------------------------------------------------------
NUM_PODS=3


# --- Detection parameters ---------------------------------------------------
# Tune these live during the demo without touching code.
SAMPLE_RATE_HZ=10
WINDOW_SECONDS=30
BREATHING_LOW_HZ=0.1
BREATHING_HIGH_HZ=0.5
TARGET_HZ=0.2
DETECTION_RATIO=4.0

# How many CIR taps the firmware sends per report.
TAPS_PER_REPORT=30


# --- Logging ----------------------------------------------------------------
LOG_DIR=data
